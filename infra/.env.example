# Template for infra/.env (gitignored, never committed).
# Copy this file to infra/.env and fill in real values before running
# docker compose -f infra/docker-compose.prod.yml up.
#
# Generate strong values with: openssl rand -hex 32
# Must match the corresponding credentials in backend/.env.production
# (DATABASE_URL for POSTGRES_PASSWORD/COMPASS_APP_PASSWORD,
# OBJECT_STORAGE_ACCESS_KEY/OBJECT_STORAGE_SECRET_KEY for the MinIO
# pair) — see docker-compose.prod.yml's own comments for why these
# values are duplicated across the two files rather than unified.

POSTGRES_PASSWORD=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32
COMPASS_APP_PASSWORD=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32
MINIO_ROOT_USER=REPLACE_ME
MINIO_ROOT_PASSWORD=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32
