# Copy to .env for local development. Never commit the real .env file.

# --- Application ---
APP_NAME=career-compass-ai
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+psycopg://compass:compass@localhost:5432/career_compass
DATABASE_POOL_SIZE=5

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object Storage (MinIO locally, S3 in deployed environments) ---
# object_storage_endpoint: where the BACKEND reaches the store (boto3).
# object_storage_public_url: where the BROWSER loads uploaded files from.
#
# Running the backend natively (not in Docker): both are the same —
# leave these as-is.
#
# Running the backend inside Docker Compose (see infra/docker-compose.yml):
# change ONLY object_storage_endpoint to the service name:
#   OBJECT_STORAGE_ENDPOINT=http://minio:9000
# Leave object_storage_public_url as http://localhost:9000 (or whatever
# address MinIO's port is published to on your host) — the browser runs
# outside Docker's network and can't resolve "minio" at all. Using the
# internal address for both broke uploads (backend couldn't reach a
# name only the browser needs) or broke viewing photos afterward
# (browser got a URL only the backend's network understands),
# depending on which value got copied to which setting.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_URL=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=compass
OBJECT_STORAGE_SECRET_KEY=compass_secret
OBJECT_STORAGE_BUCKET=career-compass-dev
# Separate, deliberately private bucket for resume uploads (Phase 5) -
# never made public-read, unlike OBJECT_STORAGE_BUCKET above.
OBJECT_STORAGE_RESUMES_BUCKET=career-compass-resumes-dev

# --- Auth ---
JWT_SECRET_KEY=change-me-in-every-environment
# 60 min balances active-editing-session UX against exposure window;
# revisit once refresh tokens exist (see docs/adr/ADR-003) — a proper
# refresh flow lets access tokens stay short-lived without users being
# logged out mid-task.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# --- AI Platform (Phase 4: real Anthropic + Ollama providers wired) ---
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=claude-sonnet-5
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Groq: free, rate-limited (not metered) tier — https://console.groq.com/keys
GROQ_API_KEY=

# --- Phone login (Firebase Phone Auth) ---
# 1. console.firebase.google.com > your project > Authentication >
#    Sign-in method > enable "Phone".
# 2. Project Settings > Service accounts > Generate new private key >
#    save the downloaded JSON as backend/secrets/firebase-service-account.json
#    (backend/secrets/ is gitignored — never commit this file).
# 3. FIREBASE_PROJECT_ID is the Project ID shown on the Project Settings
#    > General tab (e.g. "career-compass-ai-c749f"), not the display name.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=/app/secrets/firebase-service-account.json
