# Template for backend/.env.production (gitignored, never committed).
# Copy this file to backend/.env.production and fill in real values.
# See CLAUDE.md's "Environment" section for the DATABASE_URL/
# OBJECT_STORAGE_ENDPOINT "use the service name, not localhost" gotcha —
# it applies here exactly as it does in dev.

APP_NAME=Career Compass AI
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Service-name hosts (Docker Compose network), not localhost — same
# gotcha as dev's backend/.env.
#
# Two separate roles/passwords, not one — see infra/init-db/
# create-app-role.sql for why: compass_app is a restricted, non-
# superuser role the app actually connects as (genuinely subject to
# Row-Level Security); compass is the superuser/table-owner role used
# only by Alembic for DDL. Generate with: openssl rand -hex 32 — never
# reuse the dev values, and compass_app's password here must match
# docker-compose.prod.yml's COMPASS_APP_PASSWORD.
DATABASE_URL=postgresql+psycopg://compass_app:REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32@postgres:5432/career_compass
DATABASE_POOL_SIZE=10
MIGRATIONS_DATABASE_URL=postgresql+psycopg://compass:REPLACE_WITH_A_REAL_PASSWORD@postgres:5432/career_compass
REDIS_URL=redis://redis:6379/0

# Backend reaches MinIO via the Docker network; OBJECT_STORAGE_PUBLIC_URL
# is what the BROWSER uses — see the follow-up note in
# docs/runbooks/self-hosting.md about this not being fully wired for
# the tunnel setup yet (uploaded photos won't display publicly until
# that's addressed).
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PUBLIC_URL=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=REPLACE_ME
OBJECT_STORAGE_SECRET_KEY=REPLACE_WITH_A_REAL_SECRET
OBJECT_STORAGE_BUCKET=career-compass-prod

# Generate with: openssl rand -hex 32 — never reuse the dev value.
JWT_SECRET_KEY=REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# Same real values as dev, or your own production-only keys.
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=claude-sonnet-5
OLLAMA_BASE_URL=http://host.docker.internal:11434
GROQ_API_KEY=

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=/app/secrets/firebase-service-account.json

# Get a key at resend.com (Settings > API Keys). onboarding@resend.dev
# works with zero domain-verification setup; switch to a verified
# custom domain (e.g. noreply@yourdomain.com) later without code changes.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Sender for the post-signup welcome email only (see verify_signup.py) —
# any address on the same verified domain as RESEND_FROM_EMAIL works,
# no extra Resend/DNS setup needed.
RESEND_WELCOME_FROM_EMAIL=onboarding@resend.dev
# The real public domain this deployment is reachable at — used to
# build links embedded in emails (e.g. password reset).
FRONTEND_BASE_URL=https://REPLACE_WITH_YOUR_DOMAIN

# --- Platform admin bootstrap ---
# Comma-separated accounts to grant every platform.* permission to on
# the next seed run (idempotent). Each entry is a bare email (Personal
# account) or "subdomain:email" (Enterprise). Leave empty to skip.
PLATFORM_ADMIN_BOOTSTRAP_ACCOUNTS=
