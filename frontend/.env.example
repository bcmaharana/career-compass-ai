# Copy to .env.local for local development.
# Empty by default — same-origin requests are proxied to the backend by
# Vite in dev (see vite.config.ts) and by the gateway in production.
VITE_API_BASE_URL=

# The sibling `enterprise/platform` repo's own frontend — "Back to Hub"
# links in the app shell go here.
VITE_PLATFORM_BASE_URL=

# --- Phone login (Firebase Phone Auth) ---
# console.firebase.google.com > your project > Project Settings >
# General > Your apps > (add a Web app if none exists yet) > SDK setup
# and configuration > Config. These values are not secret (see
# src/lib/firebase.ts) — safe to commit to .env.example, but keep the
# real ones in .env.local like everything else here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
