# Template for frontend/.env.production (gitignored, never committed —
# not a secret, but kept out of git the same way backend/.env.production
# is, so this stays a deliberate per-environment file, not something a
# build accidentally picks up unedited).
#
# Copy this file to frontend/.env.production and set the real value.
# Without this file, VITE_PLATFORM_BASE_URL falls back to
# src/lib/platform.ts's dev default (http://localhost:5174) even in a
# prod build — this was a real live bug (2026-08-26), not hypothetical.

VITE_PLATFORM_BASE_URL=https://scaledbrain.com
